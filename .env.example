# Copy to .env for local development. NEVER commit real values.
# On Vercel set these under Project Settings > Environment Variables.

# Secret used by Make.com in the "x-api-key" header. You invent it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAKE_WEBHOOK_API_KEY=""

# Gemini (https://aistudio.google.com/apikey). Used server-side only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Up to 5 RSS/Atom feed URLs, comma separated. You choose the sources and check their terms of use.
NEWS_FEEDS=""
ITEMS_PER_FEED="3"
MAX_ITEMS_PER_RUN="8"
MAX_ITEM_AGE_HOURS="36"

# Categories that always wait for manual approval, e.g. "finance,insurance". Empty = auto-publish.
HOLD_CATEGORIES=""

# Persistent storage on Vercel (Upstash Redis via the Vercel Marketplace). Either naming works:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional
SITE_URL=""
# Only set once AdSense has approved you. ads.txt is not served without it.
ADSENSE_PUBLISHER_ID=""
